{
  "name": "stockflow-api",
  "version": "1.0.0",
  "description": "StockFlow Smart Inventory & Business Management API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "jest tests/unit tests/unit_phase4.test.js tests/unit_security.test.js --detectOpenHandles --forceExit",
    "test:unit": "jest tests/unit tests/unit_phase4.test.js tests/unit_security.test.js --detectOpenHandles --forceExit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration/postgres_transactions.integration.test.js --detectOpenHandles --forceExit",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/e2e/fresh_database_workflow.test.js --detectOpenHandles --forceExit",
    "test:all": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit tests/unit_phase4.test.js tests/unit_security.test.js tests/integration/postgres_transactions.integration.test.js tests/e2e/fresh_database_workflow.test.js --detectOpenHandles --forceExit",
    "test:watch": "jest --watch --detectOpenHandles"
  },
  "keywords": [
    "inventory",
    "pos",
    "business",
    "management",
    "stockflow"
  ],
  "author": "DHAVAL",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^11.11.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "pg": "^8.11.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
