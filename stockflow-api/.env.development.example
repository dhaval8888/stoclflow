# ─── StockFlow API — Development Environment Example ────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# PostgreSQL — local installation
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/stockflow_db

# JWT Configuration — generate with:
# node -e "const c=require('crypto'); console.log(c.randomBytes(48).toString('hex'))"
# Use DIFFERENT values for each secret. Minimum 32 characters.
JWT_ACCESS_SECRET=generate_a_random_96_char_hex_string_for_access_token_signing
JWT_REFRESH_SECRET=generate_a_different_random_96_char_hex_string_for_refresh_tokens
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cloudinary (Optional in development — image uploads disabled without this)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin SDK (Optional in development — push notifications disabled without this)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
