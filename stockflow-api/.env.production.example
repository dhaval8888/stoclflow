# ─── StockFlow API — Production Environment Example ─────────────────────────
NODE_ENV=production
PORT=3000
# In production, restrict CORS to your Flutter Web / Client domain or allow all mobile apps
CORS_ORIGIN=*

# PostgreSQL Cloud Database URL (Neon / Render / Supabase)
# Requires ?sslmode=require on most cloud providers
DATABASE_URL=postgresql://USER:STRONG_PASSWORD@ep-random-cloud-host.neon.tech/stockflow_prod?sslmode=require

# JWT Configuration (Cryptographically secure 64+ char random string)
JWT_SECRET=replace_with_openssl_rand_hex_64_production_secret_key_minimum_32
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cloudinary (Production image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Admin SDK (Production push notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
