# ─────────────────────────────────────────────────────────────────────────────
# StockFlow API — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# PostgreSQL — local format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/stockflow_db

# JWT Secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Both secrets must be at least 32 characters. Use DIFFERENT values for each.
JWT_ACCESS_SECRET=replace_with_a_random_64_char_hex_string_for_access_tokens
JWT_REFRESH_SECRET=replace_with_a_different_random_64_char_hex_string_for_refresh

# Token Expiry (optional — shown defaults)
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cloudinary — https://cloudinary.com/console (optional in development)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin SDK — https://console.firebase.google.com (optional in development)
# Download service account JSON and extract these values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and \n exactly as given by Firebase.
FIREBASE_PRIVATE_KEY=
